PORT=3000
BASE_URL=https://your-domain.com
ADMIN_TOKEN=pick-a-long-random-string
ADMIN_EMAIL=you@example.com          # where alerts go (refunds, new products to review)

# --- PayPal (blank = DEMO mode, no real charges) ---
# developer.paypal.com → Apps & Credentials. Start with sandbox, then set PAYPAL_ENV=live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                   # webhook → https://your-domain.com/api/paypal/webhook

# --- CJdropshipping supplier (blank = MOCK supplier) ---
# Top up your CJ wallet: orders are paid from that balance automatically.
CJ_API_KEY=
CJ_LOGISTIC_NAME=CJPacket Ordinary   # preferred shipping method
MAX_SHIPPING_DAYS=20

# --- Email (blank = emails are only logged) ---
RESEND_API_KEY=
EMAIL_FROM=BeautyBridge <orders@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# --- Pricing (fractions). Get the real duty rate from a customs broker. ---
DUTY_RATE=0.30
TARGET_MARGIN=0.30
PAYMENT_PCT_FEE=0.0349               # PayPal US standard rate, check yours
PAYMENT_FIXED_FEE=0.49
FREE_SHIPPING_OVER=35
SHIPPING_FEE=4.99

# --- Automation ---
DISCOVERY_KEYWORDS=face serum,sheet mask,gua sha,lash,makeup brush,heatless curl,nail art,hair clip,makeup sponge,facial cleansing brush,lip oil,scalp massager
MAX_NEW_PRODUCTS_PER_RUN=10
DISCOVERY_PER_KEYWORD=2
MAX_RETAIL_PRICE=40
MIN_PROFIT=3
REVIEW_COSMETICS=true                # cosmetics wait for your FDA check before going live
REQUEST_AUTO_SOURCE_VOTES=3
MAX_FULFIL_ATTEMPTS=5
AUTO_REFUND_ON_FAILURE=true
JOB_FULFIL_SEC=60
JOB_TRACKING_SEC=3600
JOB_DISCOVER_SEC=86400
JOB_REQUESTS_SEC=3600

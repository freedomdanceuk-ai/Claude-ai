PORT=3000
BASE_URL=http://localhost:3000
ADMIN_TOKEN=pick-a-long-random-string

# Stripe: leave blank for DEMO mode (no real charges).
# Enable Apple Pay, Google Pay and Cash App Pay in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CJdropshipping: leave blank for MOCK mode (you place supplier orders by hand).
CJ_API_KEY=
CJ_LOGISTIC_NAME=CJPacket Ordinary

# Pricing (fractions). Get the real duty rate for your products from a customs broker.
DUTY_RATE=0.30
TARGET_MARGIN=0.30
PAYMENT_PCT_FEE=0.029
PAYMENT_FIXED_FEE=0.30
